+syntax = "proto3";
+
+package word;
+
+service WordService {
+  rpc GetRandomWord (GetRandomWordRequest) returns (GetRandomWordResponse);
+}
+
+message GetRandomWordRequest {
+  uint32 length = 1; // ex: 6 pour SUTOM
+}
+
+message GetRandomWordResponse {
+  string word = 1;
+}
